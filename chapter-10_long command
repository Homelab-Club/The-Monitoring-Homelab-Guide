# 10.4 Step 1: Install Zabbix Agent 2, Run:
sudo apt update
wget
https://repo.zabbix.com/zabbix/7.4/release/ubuntu/pool/main/z/zabbix-release/zsudo dpkg -i zabbix-release_latest_7.4+ubuntu24.04_all.deb
sudo apt update
sudo apt install zabbix-agent2 -y

