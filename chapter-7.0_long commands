# 7.4 add the following grafana service in docker-compose.yml:
  grafana:
    image: grafana/grafana-oss:latest
    container_name: grafana
    restart: unless-stopped
    ports:
      - "10.10.20.8:3000:3000"
    volumes:
      - grafana_data:/var/lib/grafana

# 7.6 Check whether Grafana can resolve the Prometheus service:    
docker compose exec grafana \
  wget -q -O- http://prometheus:9090/-/ready

# 7.7 Panel 3: CPU usage (Gauge). Query A (Linux hosts):
100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[$__rate_interval])) * 100)

# 7.7 Panel 3: CPU usage (Gauge). Query B (Windows server):
100 - (avg by (instance) (rate(windows_cpu_time_total{mode="idle"}[$__rate_interval])) * 100)

# 7.7 Panel 4: Memory usage (Gauge). Query A (Linux hosts):
100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)

# 7.7 Panel 4: Memory usage (Gauge). Query B (Windows server):
100 * (1 - windows_memory_available_bytes / windows_memory_physical_total_bytes)

# 7.7 Panel 5: Disk usage (Bar gauge). Query A (root filesystem on the Linux hosts):
100 * (1 - node_filesystem_avail_bytes{mountpoint="/", fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{mountpoint="/", fstype!~"tmpfs|overlay"})

# 7.7 Panel 5: Disk usage (Bar gauge). Query B (C: drive on the Windows server):
100 * (1 - windows_logical_disk_free_bytes{volume="C:"} / windows_logical_disk_size_bytes{volume="C:"})

# 7.7 Panel 8: Network traffic (Time series). Query A (Linux, incoming):
sum by (instance)
(rate(node_network_receive_bytes_total{device!~"lo|veth.*|docker.*|br-.*"}[$__ra* 8

# 7.7 Panel 8: Network traffic (Time series). Query B (Linux, outgoing):
sum by (instance)
(rate(node_network_transmit_bytes_total{device!~"lo|veth.*|docker.*|br-.*"}[$_* 8

